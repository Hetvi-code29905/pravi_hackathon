# =========================================================================
# Gujarat R&B Infrastructure Lifecycle Platform (PRAVI) - .gitignore
# =========================================================================

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.env
backend/.env
frontend/.env

# Python Virtual Environments
backend/pravy/
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.mypy_cache/

# Node & Frontend Dependencies / Builds
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
*.local

# Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS Specific
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs & Editors
.vscode/
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.user
.gemini/
